# Echo dapp configuration. Copy to .env and fill in.
#
# Echo is public — no JWT or platform login is required. Wallet operations
# are signed client-side via the bridge (native Usernode channel inside the
# Flutter WebView, QR fallback in a desktop browser).

# Echo's on-chain address (the destination users send to). Generate via:
#   node ../usernode-dapp-starter/scripts/generate-keypair.js --env
# in this repo's root, or reuse ECHO_APP_PUBKEY from the dapp-starter .env.
ECHO_APP_PUBKEY=
ECHO_APP_SECRET_KEY=

# Sidecar node RPC. In social-vibecoding's docker-compose this resolves to
# the usernode-node service via the shared usernode-net network.
NODE_RPC_URL=http://usernode-node:3000

# HTTP port. Matches the platform scaffold's expectation of 3000.
PORT=3000
